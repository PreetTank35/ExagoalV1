# ==============================================================================
# 1. RELATIONAL SQL DATABASE (Supabase PostgreSQL / SQLite fallback)
# ==============================================================================
# Stores all generated Exams, Questions, and Institute records.
# For Supabase: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SQL_DATABASE_URL=sqlite:///./examgen.db

# ==============================================================================
# 2. VECTOR DATABASE (Supabase pgvector / local FAISS fallback)
# ==============================================================================
# Stores dense 384-d semantic vectors and curriculum chunks.
# Kept completely separated from the SQL Relational Database.
# For Supabase pgvector: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Leave empty to use high-speed local vector index
PGVECTOR_URL=

# ==============================================================================
# 3. AI / LLM INFERENCE (OpenRouter API Key)
# ==============================================================================
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat
